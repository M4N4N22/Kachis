# Optional: real model for shielded chat (never send raw paste)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Lace dApp connector network
NEXT_PUBLIC_MIDNIGHT_NETWORK=preprod

# After first deploy, paste the contract address so judges skip deploy
# NEXT_PUBLIC_KACHIS_CONTRACT_ADDRESS=

# Lace local proof server (required for Compact prove unless the wallet proves)
NEXT_PUBLIC_MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# optional server-side probe
# MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
