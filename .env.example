# Optional: OpenAI only used when a judge pastes an OpenAI BYOC key (not auto-hosted).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Kachis beta hosted model (Gemini). Shared daily pool for judges — not a user key.
# New Google AI keys often cannot call gemini-2.5-*; use gemini-3.8-flash / gemini-3.6-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Shared beta responses per UTC day (default 10).
KACHIS_BETA_CHAT_LIMIT=10

# Optional Anthropic default model when a BYOC Anthropic key is used.
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Soft required-pack gate for /api/shield and /api/chat (mirrors Compact requiredPack).
# Bitmask: bit0 PII, bit1 financial, bit2 secrets, bit3 code, bit4 client.
# 0 = no API minimum (sandbox). 31 = all packs required (institutional).
KACHIS_REQUIRED_PACK=0
KACHIS_ENFORCE_REQUIRED_PACK=1
# Fresh Compact deploy constructor arg (after recompile). Institutional = 31.
# NEXT_PUBLIC_KACHIS_REQUIRED_PACK=31

# Lace dApp connector network
NEXT_PUBLIC_MIDNIGHT_NETWORK=preprod

# Supabase (wallet-first profiles / orgs / memberships + durable shield console log)
# Create a project, run supabase/schema.sql (includes attestations), then paste keys here.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional browser anon key — unused while identity is wallet + service-role APIs
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dual Preprod instances: sandbox (requiredPack=0) vs institutional (requiredPack=31).
NEXT_PUBLIC_KACHIS_CONTRACT_ADDRESS_SANDBOX=16106cf6655663a8879a98ac071ce412c641b181d1a24af9e06a1f15f619b910
NEXT_PUBLIC_KACHIS_CONTRACT_ADDRESS_INSTITUTIONAL=ec898ae76d13cf947ed6f7c342c54f9f54cea447d0a113a40d7a980d5aa34d75
# Legacy single pin — institutional fallback only (sandbox does not inherit this).
# NEXT_PUBLIC_KACHIS_CONTRACT_ADDRESS=ec898ae76d13cf947ed6f7c342c54f9f54cea447d0a113a40d7a980d5aa34d75
# Keep 0 so Approve & Settle reuses the pinned address (does not redeploy each time).
NEXT_PUBLIC_KACHIS_FORCE_REDEPLOY=0
NEXT_PUBLIC_KACHIS_REQUIRED_PACK_SANDBOX=0
NEXT_PUBLIC_KACHIS_REQUIRED_PACK_INSTITUTIONAL=31
# Historical Wave 1 address (proof only): d145333b792908a93fe7abacf5753ba8e63ecc6291bc76a901ebfed8f5f9f24f
# Historical empty-ctor redeploy: 2440ed058a4ce3eb4f19fed09c7a09626e009b912a1b9293b61e55750ae676cd

# Lace local proof server (required for Compact prove unless the wallet proves)
NEXT_PUBLIC_MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# optional server-side probe
# MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
