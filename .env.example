# Optional: OpenAI only used when a judge pastes an OpenAI BYOC key (not auto-hosted).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Kachis beta hosted model (Gemini). Shared daily pool for judges — not a user key.
# New Google AI keys often cannot call gemini-2.5-*; use gemini-3.8-flash / gemini-3.6-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Shared beta responses per UTC day (default 10).
KACHIS_BETA_CHAT_LIMIT=10

# Optional Anthropic default model when a BYOC Anthropic key is used.
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Soft required-pack gate for /api/shield and /api/chat (mirrors Compact requiredPack).
# Bitmask: bit0 PII, bit1 financial, bit2 secrets, bit3 code, bit4 client.
# 0 = no API minimum (sandbox). 31 = all packs required (institutional).
KACHIS_REQUIRED_PACK=0
KACHIS_ENFORCE_REQUIRED_PACK=1
# Fresh Compact deploy constructor arg (after recompile). Institutional = 31.
# NEXT_PUBLIC_KACHIS_REQUIRED_PACK=31

# Lace dApp connector network
NEXT_PUBLIC_MIDNIGHT_NETWORK=preprod

# Supabase (wallet-first profiles / orgs / memberships)
# Create a project, run supabase/schema.sql, then paste keys here.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional browser anon key — unused while identity is wallet + service-role APIs
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# After first deploy, paste the contract address so judges skip deploy / lists read chain
# NEXT_PUBLIC_KACHIS_CONTRACT_ADDRESS=d145333b792908a93fe7abacf5753ba8e63ecc6291bc76a901ebfed8f5f9f24f
NEXT_PUBLIC_KACHIS_CONTRACT_ADDRESS=d145333b792908a93fe7abacf5753ba8e63ecc6291bc76a901ebfed8f5f9f24f

# Lace local proof server (required for Compact prove unless the wallet proves)
NEXT_PUBLIC_MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# optional server-side probe
# MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
