# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# agent
/agent/node_modules

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime attestation store (seed lives in data/)
.data/

# local design / program notes (not for public remote)
design.md
design-brief.md
midnight-buildathon-brief.md
copy.md
product.md

# Cursor / local agent internals
.cursor/
CLAUDE.md

# Compact proving keys under managed/ (large). Re-generate with compact/compile.sh.
# Production settle serves a committed copy from public/zk/kachis-guardrail/.
compact/managed/**/keys/
compact/managed/**/zkir/
compact/managed/**/compiler/
