pragma language_version 0.23;

import CompactStandardLibrary;

// Kachis guardrail: prove a policy pack ran without disclosing the original prompt.
// Private witness: SHA-256 of the raw paste.
// Public ledger: cleaned-prompt commitment + pack flags + attestation id.

struct Attestation {
  cleanedHash: Bytes<32>;
  binding: Bytes<32>;
  packFlags: Uint<8>;
}

export ledger attestations: Map<Uint<64>, Attestation>;
export ledger nextId: Counter;
export ledger totalShielded: Counter;

witness originalCommitment(): Bytes<32>;

constructor() {}

export circuit shield(
  cleanedHash: Bytes<32>,
  packFlags: Uint<8>
): [] {
  const original = originalCommitment();
  const binding = persistentHash<Vector<2, Bytes<32>>>([original, cleanedHash]);

  nextId.increment(1);
  const id = disclose(nextId.read() as Uint<64>);

  attestations.insert(id, Attestation {
    cleanedHash: disclose(cleanedHash),
    binding: disclose(binding),
    packFlags: disclose(packFlags)
  });

  totalShielded.increment(1);
}
